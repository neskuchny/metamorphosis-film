{
  "name": "metamorphosis-film",
  "version": "1.1.0",
  "description": "Company name in, voiced film out: what awaits this company in the AI era.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "example": "node scripts/render.mjs examples/artel/film.json",
    "doctor": "node scripts/doctor.mjs",
    "bundle": "node scripts/bundle.mjs",
    "build:world": "esbuild player/world/src.js --bundle --minify --format=iife --global-name=FilmWorld --legal-comments=eof --outfile=player/world.js"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "postprocessing": "^6.36.4",
    "three": "^0.170.0"
  }
}
